# Servidor
PORT=4100

# PostgreSQL
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?sslmode=disable
DB_CONN=

# Seguridad
# Clave usada para firmar los JWT. Genera un valor aleatorio, por ejemplo:
# openssl rand -base64 48
SECRET_KEY=
# Clave heredada de sesiones de Echo; la autenticacion actual no la usa.
AUTH_KEY=

# CORS y frontend
ALLOW_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# true solo en produccion con HTTPS
COOKIE_SECURE=false

# Archivos subidos
UPLOAD_PATH=./uploads

# Correo (recuperacion de contrasena)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CattFileManager